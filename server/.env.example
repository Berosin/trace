PORT=4000

# Required. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Required. From your Supabase project: Settings -> API.
# Run supabase/schema.sql (in the repo root) in the SQL Editor first.
# SUPABASE_SERVICE_ROLE_KEY is secret — server-side only, never expose it to
# the frontend or commit it to source control.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=